---
import '@fontsource/jetbrains-mono';
import '../styles/global.css';
import SEO from '../components/SEO.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  home?: boolean;
  noindex?: boolean;
}
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <SEO {...Astro.props} />
  </head>
  <body class="bg-zinc-950 text-zinc-300 font-sans antialiased selection:bg-emerald-900 selection:text-white">
    <header class="border-b border-zinc-800 bg-zinc-900/50 backdrop-blur-md sticky top-0 z-50">
      <div class="max-w-5xl mx-auto px-4 h-10 flex justify-between items-center text-[10px] font-mono tracking-widest text-zinc-400">
        <div class="flex items-center gap-4">
          <span class="text-emerald-500 font-bold">● ONLINE</span>
          <span class="hidden sm:inline">COLLINS_MWANGI::SYSTEM</span>
        </div>
        <div class="flex gap-4">
          <span
            id="loc-display"
            title="Your country, and the Cloudflare data centre serving this page"
            class="hover:text-emerald-400 transition-colors cursor-default"
          >LOC: --</span>
          <span
            title="Round-trip time from your browser to the Cloudflare data centre serving this page"
            class="hover:text-blue-400 transition-colors cursor-default"
          >RTT: <span id="ping">--</span>ms</span>
        </div>
      </div>
    </header>

    <main class="min-h-screen max-w-5xl mx-auto px-4 py-12 md:py-20">
      <slot />
    </main>

    <footer class="border-t border-zinc-800 mt-20 py-8 text-center text-xs text-zinc-400 font-mono">
      <p>HOSTED ON CLOUDFLARE</p>
      <p class="mt-2">
        Code under the
        <a
          href="https://github.com/ny-collins/ny-collins/blob/main/LICENSE"
          class="underline hover:text-white focus:outline-none focus:ring-2 focus:ring-emerald-500 rounded"
        >MIT License</a>.
        Text and personal content © {new Date().getFullYear()} Collins Mwangi.
      </p>
    </footer>

    <script>
      // Header readout: the visitor's country, the Cloudflare data centre that served the page,
      // and a real round-trip time to it. Cloudflare answers /cdn-cgi/trace on every proxied
      // hostname, so this calls our own origin and needs no cross-origin permission.
      // It does nothing on localhost, where that endpoint does not exist.
      const locEl = document.getElementById('loc-display');
      const pingEl = document.getElementById('ping');

      type Sample = { ms: number; fields: Record<string, string> };

      async function sample(): Promise<Sample> {
        const t0 = performance.now();
        const res = await fetch('/cdn-cgi/trace', { cache: 'no-store' });
        if (!res.ok) throw new Error(String(res.status));
        const body = await res.text();
        const ms = performance.now() - t0;
        const fields: Record<string, string> = {};
        for (const line of body.split('\n')) {
          const i = line.indexOf('=');
          if (i > 0) fields[line.slice(0, i)] = line.slice(i + 1).trim();
        }
        return { ms, fields };
      }

      async function measure() {
        try {
          const runs: Sample[] = [];
          for (let i = 0; i < 3; i++) runs.push(await sample());
          const best = Math.min(...runs.map((r) => r.ms));
          const { loc, colo } = runs[0].fields;
          if (pingEl) pingEl.textContent = String(Math.round(best));
          if (locEl && loc) locEl.textContent = colo ? `LOC: ${loc} via ${colo}` : `LOC: ${loc}`;
        } catch {
          // Leave the placeholders; this readout is decorative.
        }
      }

      const isLocal = ['localhost', '127.0.0.1', '[::1]'].includes(location.hostname);
      if (!isLocal) {
        if (document.readyState === 'complete') void measure();
        else window.addEventListener('load', () => void measure(), { once: true });
      }
    </script>
  </body>
</html>
